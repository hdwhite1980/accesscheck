<Window x:Class="AccessLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AccessLens — Least-Privilege Access Broker"
        Width="1180" Height="820"
        Background="{StaticResource PageBg}"
        Loaded="Window_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Steel}" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="AccessLens" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="HeaderStatus" Foreground="#C9D6E6" FontSize="12"
                           Margin="18,6,0,0" Text="Not signed in"/>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Ready."/>
        </StatusBar>

        <TabControl x:Name="Tabs" Margin="10">

            <!-- ================= REQUEST ================= -->
            <TabItem Header="New Request">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14" MaxWidth="1050">
                        <TextBlock Style="{StaticResource H1}" Text="Describe the function the user needs to perform"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Plain English. The GenAI endpoint sees only this text plus role names and action lists from your synced catalog — never a username or tenant ID. Its suggestion is then validated deterministically: unknown actions are rejected, covering roles are ranked by over-privilege delta per service."/>
                        <TextBox x:Name="FunctionText" Margin="0,10,0,8" Height="64"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 FontSize="14"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="RecommendButton" Content="Analyze &amp; Recommend" Click="Recommend_Click"/>
                            <CheckBox x:Name="UseDemoCheck" Content="Offline demo suggester (no GenAI call)"
                                      Margin="16,6,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="ReasoningText" Style="{StaticResource Hint}" Margin="0,0,0,10"/>

                        <StackPanel x:Name="OutcomesPanel"/>

                        <Border Style="{StaticResource Card}" x:Name="ExecutePanel" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H1}" Text="Approve and execute"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Principal (recipient)" Grid.Row="0" Margin="0,6"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                        <TextBox x:Name="PrincipalBox" Width="340"
                                                 ToolTip="Entra object ID of the user receiving access — or use Find user."/>
                                        <Button x:Name="FindUserButton" Content="Find user…" Click="FindUser_Click"
                                                Margin="8,0,0,0"
                                                ToolTip="Search the tenant by name or UPN; selecting fills the object ID and the UPN field automatically. Requires User.Read.All consent."/>
                                        <TextBlock x:Name="PrincipalDisplay" Margin="10,6,0,0" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                    <TextBlock Text="Duration" Grid.Row="1" Margin="0,6"
                                               ToolTip="Human-friendly ('14 days', '8 hours', '2 weeks', '1 month') or raw ISO 8601 ('P14D'). Converted automatically."/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                        <TextBox x:Name="DurationBox" Width="180" Text="14 days"
                                                 TextChanged="Duration_TextChanged"/>
                                        <TextBlock x:Name="DurationPreview" Margin="10,6,0,0" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                    <TextBlock Text="Directory assignment type" Grid.Row="2" Margin="0,6"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                        <RadioButton x:Name="ActiveRadio" Content="Active (live now, PIM expires it)"
                                                     GroupName="AType" IsChecked="True"/>
                                        <RadioButton x:Name="EligibleRadio" Content="Eligible (user self-activates, max 8h)"
                                                     GroupName="AType" Margin="18,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="PIM group ID (optional)" Grid.Row="3" Margin="0,6"
                                               ToolTip="For Intune/CloudPC/Defender grants: a PIM-for-Groups onboarded group that already holds the role. Membership is granted time-bound so expiry stays server-side."/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                        <TextBox x:Name="PimGroupBox" Width="340"/>
                                        <Button x:Name="SetupPimButton" Content="Set up PIM group…" Click="SetupPimGroup_Click"
                                                Margin="8,0,0,0"
                                                ToolTip="Automates the pre-staging for the selected Intune/Windows 365/Defender grant: creates a security group, attaches the chosen role to it, and fills this box. The group onboards to PIM automatically at its first time-bound membership grant. Requires Group.ReadWrite.All consent; members need Entra ID Governance/P2 licensing for PIM."/>
                                    </StackPanel>
                                    <TextBlock Text="Principal UPN (Exchange/Purview)" Grid.Row="4" Margin="0,6"
                                               ToolTip="Exchange and Purview cmdlets take a UPN, not an object ID. Required only when an Exchange/Purview grant is selected."/>
                                    <TextBox x:Name="UpnBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Add permission:" Margin="0,6,8,0"
                                               ToolTip="Manually add a resource action / cmdlet to this request before execution. It must exist in the synced catalog; the whole request is re-validated (roles, deltas, custom-role drafts recompute) and the addition is recorded in the audit trail as human-added."/>
                                    <TextBox x:Name="ManualActionBox" Width="420"
                                             TextChanged="ManualAction_TextChanged"
                                             ToolTip="Start typing — matching catalog permissions appear below; click one to select it, then Add."/>
                                    <Button x:Name="AddActionButton" Content="Add &amp; re-validate"
                                            Click="AddAction_Click" Margin="8,0,0,0"/>
                                    <Button x:Name="AskAiActionButton" Content="Ask AI…" Click="AskAiAction_Click"
                                            Margin="8,0,0,0"
                                            ToolTip="Describe what the person needs to do in plain language; the AI proposes matching permissions from your catalog (validated — it can only pick actions that exist)."/>
                                </StackPanel>
                                <ListBox x:Name="ActionSuggestList" MaxHeight="150" Margin="0,2,0,0"
                                         Visibility="Collapsed" FontFamily="Consolas" FontSize="12"
                                         MouseUp="ActionSuggestList_MouseUp"/>
                                <TextBlock x:Name="ManualActionsText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,8"
                                           Text="Directory grants use PIM schedule requests — Entra removes access on schedule even if this machine is off. Intune / Windows 365 / Defender grants have no PIM: provide a PIM group above to keep expiry server-side, otherwise the grant is direct and Housekeeping removes it at expiry. Exchange and Purview grants run as PowerShell (shown for review before anything executes): a derived custom role with the exact cmdlets when needed, carried by a per-grant AL- role group; Housekeeping removes membership at expiry and deletes the group/role when empty."/>
                                <Button x:Name="ExecuteButton" Content="Approve selected grants…" Click="Execute_Click"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= CATALOG ================= -->
            <TabItem Header="Catalog">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource H1}" Text="Tenant permission catalog"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Live sync across every service: Entra directory (Graph v1.0), Intune, Windows 365, Defender XDR (Graph beta), and — via PowerShell — Exchange Online and Purview / Security &amp; Compliance at cmdlet level (Get-ManagementRole + role entries), which is the exact vocabulary derived custom roles are built from. Providers your licenses or consents don't cover are skipped and listed — the catalog is always your tenant's current truth, never a shipped list."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                            <Button x:Name="SyncButton" Content="Sync all providers" Click="Sync_Click"/>
                            <Button x:Name="SyncReportButton" Content="Sync report…" Click="SyncReport_Click"
                                    Margin="10,0,0,0"
                                    ToolTip="Full per-provider detail: exact HTTP status, which permission is likely missing, and the PowerShell host in use."/>
                            <CheckBox x:Name="ExoSyncCheck" Margin="16,7,0,0" IsChecked="True"
                                      Content="Include Exchange &amp; Purview via PowerShell (cmdlet-level; needs pwsh + ExchangeOnlineManagement)"/>
                        </StackPanel>
                        <TextBlock x:Name="SyncSummary" Margin="0,0,0,8" Style="{StaticResource Hint}"/>
                        <TextBox x:Name="CatalogFilter" Width="320" HorizontalAlignment="Left"
                                 Margin="0,0,0,8" TextChanged="CatalogFilter_TextChanged"
                                 ToolTip="Filter roles by name or action"/>
                    </StackPanel>
                    <DataGrid x:Name="CatalogGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="180"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Name}" Width="300"/>
                            <DataGridTextColumn Header="Built-in" Binding="{Binding BuiltIn}" Width="70"/>
                            <DataGridTextColumn Header="Actions" Binding="{Binding ActionCount}" Width="70"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ================= HISTORY ================= -->
            <TabItem Header="History">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource H1}" Text="Audit history"/>
                        <Button Content="Refresh" Click="HistoryRefresh_Click" Margin="16,0,0,8"/>
                    </StackPanel>
                    <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When (UTC)" Binding="{Binding When}" Width="140"/>
                            <DataGridTextColumn Header="Function" Binding="{Binding Function}" Width="260"/>
                            <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="150"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="200"/>
                            <DataGridTextColumn Header="Delta" Binding="{Binding Delta}" Width="55"/>
                            <DataGridTextColumn Header="Added" Binding="{Binding Added}" Width="55"/>
                            <DataGridTextColumn Header="Approved" Binding="{Binding Approved}" Width="80"/>
                            <DataGridTextColumn Header="Expiry" Binding="{Binding Expiry}" Width="140"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ================= HOUSEKEEPING ================= -->
            <TabItem Header="Housekeeping">
                <StackPanel Margin="14" MaxWidth="1050">
                    <TextBlock Style="{StaticResource H1}" Text="Housekeeping"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="1) Removes expired direct grants (Intune / Windows 365 / Defender assignments past their tracked expiry). 2) Finds AccessLens-created custom roles with zero remaining assignments and offers to delete them. Directory PIM grants never need this — Entra expires them itself."/>
                    <Button x:Name="HousekeepingButton" Content="Run housekeeping" Click="Housekeeping_Click"
                            HorizontalAlignment="Left" Margin="0,10,0,10"/>
                    <TextBox x:Name="HousekeepingLog" Height="440" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </TabItem>

            <!-- ================= SETTINGS ================= -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14" MaxWidth="760">
                        <TextBlock Style="{StaticResource H1}" Text="Tenant"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Cloud" Grid.Row="0" Margin="0,8"/>
                            <ComboBox x:Name="CloudCombo" Grid.Row="0" Grid.Column="1" Margin="0,4">
                                <ComboBoxItem Content="Dod"/>
                                <ComboBoxItem Content="GccHigh"/>
                                <ComboBoxItem Content="Commercial"/>
                            </ComboBox>
                            <TextBlock Text="Tenant ID" Grid.Row="1" Margin="0,8"/>
                            <TextBox x:Name="TenantBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Text="Client ID (app reg)" Grid.Row="2" Margin="0,8"/>
                            <TextBox x:Name="ClientBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Text="Max acceptable excess" Grid.Row="3" Margin="0,8"
                                       ToolTip="If the best built-in role grants more than this many actions beyond the need, a custom role is drafted instead."/>
                            <TextBox x:Name="ExcessBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Text="5"/>
                        </Grid>

                        <TextBlock Style="{StaticResource H1}" Text="GenAI endpoint" Margin="0,16,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Provider" Grid.Row="0" Margin="0,8"/>
                            <ComboBox x:Name="AiProviderCombo" Grid.Row="0" Grid.Column="1" Margin="0,4">
                                <ComboBoxItem Content="openai-compatible"/>
                                <ComboBoxItem Content="azure-openai"/>
                                <ComboBoxItem Content="anthropic"/>
                            </ComboBox>
                            <TextBlock Text="Base URL" Grid.Row="1" Margin="0,8"
                                       ToolTip="OpenAI-compatible: base up to /chat/completions. Azure OpenAI: the resource endpoint (https://YOUR-RESOURCE.openai.azure.com or .us). Anthropic: leave blank for api.anthropic.com."/>
                            <TextBox x:Name="AiUrlBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Text="Model / deployment" Grid.Row="2" Margin="0,8"
                                       ToolTip="Model name (e.g. gpt-4o, claude-sonnet-4-6) — for Azure OpenAI this is the DEPLOYMENT name."/>
                            <TextBox x:Name="AiModelBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Text="Auth header" Grid.Row="3" Margin="0,8"
                                       ToolTip="OpenAI-compatible only; Azure and Anthropic use their fixed headers automatically."/>
                            <TextBox x:Name="AiHeaderBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Text="Authorization"/>
                            <TextBlock Text="API version (Azure)" Grid.Row="4" Margin="0,8"/>
                            <TextBox x:Name="AiApiVersionBox" Grid.Row="4" Grid.Column="1" Margin="0,4"
                                     ToolTip="Azure OpenAI api-version query parameter, e.g. 2024-06-01. Ignored by other providers."/>
                            <TextBlock Text="API key" Grid.Row="5" Margin="0,8"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <PasswordBox x:Name="AiKeyBox" Width="340"/>
                                <Button Content="Store key (DPAPI)" Click="StoreKey_Click" Margin="10,0,0,0"/>
                                <TextBlock x:Name="KeyStatus" Margin="10,6,0,0" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Data boundary: whichever provider is selected receives the function description plus role names and action lists — never identities. For IL5/MED365 work keep this pointed at an authorized endpoint (org gateway or Azure OpenAI Gov); commercial OpenAI/Anthropic endpoints are appropriate for commercial tenants and lab work."/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Save settings" Click="SaveSettings_Click"/>
                            <TextBlock x:Name="SettingsStatus" Margin="12,7,0,0" Style="{StaticResource Hint}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,18,0,0"
                                   Text="Sign-in is interactive (MSAL public client, delegated) — every Graph write is attributed to your admin account in the Entra audit log. The GenAI key and sign-in token cache are DPAPI-encrypted per user. Prompts sent to the GenAI endpoint are logged verbatim to prompt-log.txt in the AccessLens data folder."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
