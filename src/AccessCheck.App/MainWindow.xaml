                                         Content="Permissions" Checked="CatalogMode_Changed"
                                         Margin="14,4,0,0"
                                         ToolTip="Every permission the tenant defines, independent of roles. This is the view a least-privilege decision actually starts from: what exists for this task, and which is narrowest."/>
                            <ComboBox x:Name="PermProviderFilter" Width="200" Margin="18,0,0,0"
