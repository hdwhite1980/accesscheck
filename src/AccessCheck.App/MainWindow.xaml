            <!-- ================= HISTORY ================= -->
            <!-- ================= REFERENCE ================= -->
            <TabItem Header="Reference">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource H1}"
                                   Text="Microsoft's permission reference"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="Microsoft's OWN list of every permission Entra defines, read live from /roleManagement/directory/resourceNamespaces — not scraped from a documentation page, so it is always current and works in the US Gov and DoD clouds. It carries Microsoft's descriptions and their authoritative isPrivileged flag. Your Catalog is DERIVED from the roles your tenant happens to define, so a permission Microsoft supports but no role grants is invisible there — which matters most when drafting a custom role."/>
