                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150"/>
                            <DataGridTextColumn Header="Microsoft says" Binding="{Binding Risk}" Width="110"/>
                            <DataGridTextColumn Header="This app infers" Binding="{Binding AppRisk}" Width="110"/>
                            <DataGridTextColumn Header="In your roles" Binding="{Binding InCatalog}" Width="100"/>
