                            <TextBlock x:Name="AppScanSummary" Margin="14,7,0,0" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <TextBlock x:Name="AppScanWarnings" Style="{StaticResource Hint}"
                                   Foreground="#B26A00" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBox x:Name="AppFilter" Width="320" HorizontalAlignment="Left"
                                 Margin="0,0,0,8" TextChanged="AppFilter_TextChanged"
                                 ToolTip="Filter by application name or permission"/>
                    </StackPanel>
                    <DataGrid x:Name="AppsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CanUserSortColumns="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="240"/>
                            <DataGridTextColumn Header="High risk" Binding="{Binding HighRisk}" Width="80"/>
                            <DataGridTextColumn Header="App-only" Binding="{Binding AppOnly}" Width="80"/>
                            <DataGridTextColumn Header="Total perms" Binding="{Binding Total}" Width="90"/>
                            <DataGridTextColumn Header="Directory roles" Binding="{Binding Roles}" Width="200"/>
                            <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Catalog">
