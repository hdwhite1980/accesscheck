                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Service principals and their granted API permissions — application (app-only) permissions run with no signed-in user, never expire, are invisible to user access reviews, and no PIM policy touches them. This is where standing privilege accumulates. High-risk grants (ReadWrite, RoleManagement, AppRoleAssignment, Directory.ReadWrite, PrivilegedAccess, Application.ReadWrite) are counted separately, and any directory role an app holds is shown."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                            <Button x:Name="AppScanButton" Content="Scan applications" Click="AppScan_Click"/>
                            <CheckBox x:Name="AppOnlyWithPermsCheck" Content="Only apps holding permissions or roles"
