            <!-- ================= SETTINGS ================= -->
            <!-- ================= GUIDE ================= -->
            <TabItem Header="Guide">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="1100" HorizontalAlignment="Left">

                        <TextBlock Style="{StaticResource H1}" Text="Using AccessCheck well"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="An access broker nobody understands gets clicked through, and clicking through is how over-privilege happens. This explains the reasoning, not just the buttons."/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Writing a good request" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Steel}"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="DESCRIBE THE JOB, NOT THE ROLE. &quot;Reset passwords for the service desk&quot; works. &quot;Give them Password Administrator&quot; defeats the point — you have already made the decision the tool exists to check."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="DESCRIBE THE RESOURCE, NOT THE FEATURE. Permissions are named after what they act on. There is no &quot;GPO analytics&quot; permission — that feature reads device configuration profiles and security baselines, and those are the permissions. The app knows many of these mappings, but phrasing it as what is read or changed always works better."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="SET THE SERVICE WHEN YOU KNOW IT. The Service picker beside Analyze removes the one judgement the model gets wrong most often. Auto-detect is fine; explicit is better."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="SAY WHAT THEY MUST NOT DO. &quot;But not administrators&quot;, &quot;only for their own team&quot;, &quot;without being able to change anything&quot; — the app detects these and tells you which mechanism actually enforces them, because no permission can."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Reading the verdict" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Steel}"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="WARNINGS COME FIRST, deliberately. A recommendation sitting under a red card is not a recommendation to act on."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="&quot;ZERO EXCESS&quot; IS NOT ALWAYS GOOD. If the single permission granted is a service-wide action, zero excess is arithmetic, not safety — the action IS the whole service. The breadth guard flags exactly this and lists narrower alternatives."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="EXCESS IS RISK-WEIGHTED. Roles rank by what the extra permissions LET SOMEONE DO. A role with five extra admin permissions ranks worse than one with six extra reads, which is the opposite of what a raw count would tell you."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="BUILT-IN CAN BEAT CUSTOM. A custom role with exactly the needed permissions is minimal, but a restricted built-in role may be SAFER: Password Administrator cannot touch privileged accounts, while a custom role built from the raw password permission can. Fewer permissions is not always less privilege."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="THE THRESHOLD IS YOURS. Settings controls how much excess is acceptable before a custom role is drafted instead. Raise it to prefer existing roles (less to govern); lower it to prefer minimal custom roles (genuinely least privilege). Both are defensible."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="How expiry actually works" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Steel}"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Worth understanding before you approve anything — the differences are not cosmetic."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="ENTRA DIRECTORY ROLES use PIM schedule requests. Entra removes the access on schedule even if this machine is never switched on again. The strongest option, and the only one that is truly self-cleaning."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="INTUNE, WINDOWS 365 AND DEFENDER have no PIM. They also assign roles to GROUPS, not to users. PIM-for-Groups keeps expiry server-side; direct membership does not expire at all and depends on Housekeeping being run."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="ADMINISTRATIVE UNITS narrow a directory role to a slice of the directory. This is how &quot;only for Sales&quot; is genuinely achieved — not by choosing a different permission."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="PERMANENT GRANTS are allowed, shown in red, and recorded as PERMANENT. Nothing will remove them. Use them deliberately, not by accident."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="HOUSEKEEPING NEVER DELETES ON ITS OWN. Scanning is read-only: it lists what has expired and you tick what to remove. That means time-bounding outside PIM is only as reliable as your habit of running it."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Strategies that make this work" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Steel}"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="PREFER JOINING A GROUP OVER MINTING A ROLE. After a group sync, New Request tells you when an existing group already grants what is needed. Every new role is another object to govern, review and eventually clean up."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="MOVE OFF DIRECT ASSIGNMENT. If the Groups tab reports that every role-holder is a user rather than a group, that is a finding in itself: direct assignments must be granted and revoked one at a time, and they do not appear in group-based access reviews."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="REVIEW BEFORE YOU GRANT. Access Review on the requester often shows they already hold what they are asking for, through a group they forgot about. It also shows what they hold that nobody can justify."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="USE ELIGIBLE, NOT ACTIVE, FOR ANYTHING PRIVILEGED. An eligible assignment means they activate it when they need it, with a record each time. Standing access is the thing every assessor asks about."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="SCOPE BEFORE YOU NARROW PERMISSIONS. An administrative unit often achieves more than an hour spent trimming an action list, because it limits WHO the role can touch rather than what it can do."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="THE HISTORY IS THE EVIDENCE. Every analysis is recorded whether or not it was approved, including what the AI proposed and what the validator rejected. &quot;What was considered and turned down&quot; is a question you will eventually be asked."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="RE-SYNC AFTER TENANT CHANGES. The catalog is a snapshot. If someone creates a role in a portal, this app cannot see it until you sync — and a stale catalog is the one failure mode that looks like a bug but is not."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="What it deliberately will not do" FontSize="15"
                                           FontWeight="SemiBold" Foreground="{StaticResource Warn}"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="It will not invent a permission. Anything absent from your synced catalog is rejected, even if the model is confident about it."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="It will not guess when it does not know. &quot;No confident match&quot; is a real answer — granting a guess is worse than granting nothing."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="It will not send identity data to the AI endpoint. The prompt-building code physically has no parameter for a username, object id, or tenant id."/>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="It will not let the AI decide what gets granted. The model proposes permissions; deterministic code validates them, ranks the roles, and applies every guard."/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14" MaxWidth="760">
                        <TextBlock Style="{StaticResource H1}" Text="Tenant"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Cloud" Grid.Row="0" Margin="0,8"/>
                            <ComboBox x:Name="CloudCombo" Grid.Row="0" Grid.Column="1" Margin="0,4">
                                <ComboBoxItem Content="Dod"/>
                                <ComboBoxItem Content="GccHigh"/>
                                <ComboBoxItem Content="Commercial"/>
                            </ComboBox>
                            <TextBlock Text="Tenant ID" Grid.Row="1" Margin="0,8"/>
                            <TextBox x:Name="TenantBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Text="Client ID (app reg)" Grid.Row="2" Margin="0,8"/>
                            <TextBox x:Name="ClientBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Text="Max acceptable excess" Grid.Row="3" Margin="0,8"
                                       ToolTip="If the best built-in role grants more than this many actions beyond the need, a custom role is drafted instead."/>
                            <TextBox x:Name="ExcessBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Text="5"/>
                        </Grid>

                        <TextBlock Style="{StaticResource H1}" Text="GenAI endpoint" Margin="0,16,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Provider" Grid.Row="0" Margin="0,8"/>
                            <ComboBox x:Name="AiProviderCombo" Grid.Row="0" Grid.Column="1" Margin="0,4">
                                <ComboBoxItem Content="openai-compatible"/>
                                <ComboBoxItem Content="azure-openai"/>
                                <ComboBoxItem Content="anthropic"/>
                            </ComboBox>
                            <TextBlock Text="Base URL" Grid.Row="1" Margin="0,8"
                                       ToolTip="OpenAI-compatible: base up to /chat/completions. Azure OpenAI: the resource endpoint (https://YOUR-RESOURCE.openai.azure.com or .us). Anthropic: leave blank for api.anthropic.com."/>
                            <TextBox x:Name="AiUrlBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Text="Model / deployment" Grid.Row="2" Margin="0,8"
                                       ToolTip="Model name (e.g. gpt-4o, claude-sonnet-4-6) — for Azure OpenAI this is the DEPLOYMENT name."/>
                            <TextBox x:Name="AiModelBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Text="Auth header" Grid.Row="3" Margin="0,8"
                                       ToolTip="OpenAI-compatible only; Azure and Anthropic use their fixed headers automatically."/>
                            <TextBox x:Name="AiHeaderBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Text="Authorization"/>
                            <TextBlock Text="API version (Azure)" Grid.Row="4" Margin="0,8"/>
                            <TextBox x:Name="AiApiVersionBox" Grid.Row="4" Grid.Column="1" Margin="0,4"
                                     ToolTip="Azure OpenAI api-version query parameter, e.g. 2024-06-01. Ignored by other providers."/>
                            <TextBlock Text="API key" Grid.Row="5" Margin="0,8"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <PasswordBox x:Name="AiKeyBox" Width="340"/>
                                <Button Content="Store key (DPAPI)" Click="StoreKey_Click" Margin="10,0,0,0"/>
                                <TextBlock x:Name="KeyStatus" Margin="10,6,0,0" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Data boundary: whichever provider is selected receives the function description plus role names and action lists — never identities. For IL5/MED365 work keep this pointed at an authorized endpoint (org gateway or Azure OpenAI Gov); commercial OpenAI/Anthropic endpoints are appropriate for commercial tenants and lab work."/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Save settings" Click="SaveSettings_Click"/>
                            <Button Content="Sign out / re-consent" Click="SignOut_Click" Margin="10,0,0,0"
                                    ToolTip="Clears the cached sign-in token. Required after granting NEW permissions in Entra — an existing token keeps the scope set it was issued with and will not pick up newly consented permissions on its own."/>
                            <Button Content="Check permissions…" Click="CheckScopes_Click" Margin="10,0,0,0"
                                    ToolTip="Signs in and shows exactly which scopes the issued token carries versus what this build requests — the definitive test for a permission problem."/>
                            <TextBlock x:Name="SettingsStatus" Margin="12,7,0,0" Style="{StaticResource Hint}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,18,0,0"
                                   Text="Sign-in is interactive (MSAL public client, delegated) — every Graph write is attributed to your admin account in the Entra audit log. The GenAI key and sign-in token cache are DPAPI-encrypted per user. Prompts sent to the GenAI endpoint are logged verbatim to prompt-log.txt in the AccessCheck data folder."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
