<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Publisher MUST match the signing certificate's Subject exactly, character for
       character, or Windows refuses to install the package. build-msix.ps1 rewrites
       this line from the certificate so the two can never drift. -->
  <Identity
    Name="AHTS.AccessCheck"
    Publisher="CN=Accelerated Hues Technology Services LLC"
    Version="0.2.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>AccessCheck</DisplayName>
    <PublisherDisplayName>Accelerated Hues Technology Services LLC</PublisherDisplayName>
    <Description>Least-privilege access broker for Microsoft 365 and Azure.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 10.0.17763 (1809) is the floor for full-trust MSIX on supported Windows. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <!-- Full trust: the app shells out to PowerShell for Exchange/Purview and opens a
         browser for sign-in. Neither works inside the restricted MSIX container. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="AccessCheck" Executable="AccessCheck.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="AccessCheck"
        Description="Least-privilege access broker for Microsoft 365 and Azure."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="AccessCheck">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#294F7D" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
